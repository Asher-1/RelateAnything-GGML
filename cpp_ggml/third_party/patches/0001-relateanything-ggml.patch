diff --git a/src/ggml-vulkan/vulkan-shaders/norm_row.comp b/src/ggml-vulkan/vulkan-shaders/norm_row.comp
new file mode 100644
index 00000000..97ba3fd2
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/norm_row.comp
@@ -0,0 +1,39 @@
+#version 450
+
+#include "types.glsl"
+#include "generic_unary_head.glsl"
+
+#extension GL_KHR_shader_subgroup_basic : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+
+// Row-wise normalization with one subgroup per row. Short rows (a few dozen
+// channels per token) leave most of the 512-thread workgroup idle in the
+// generic norm.comp and pay nine block-wide reduction barriers per row; the
+// subgroup variant keeps every lane busy with coalesced reads and reduces
+// without a single barrier.
+layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint row = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
+    const uint lane = gl_SubgroupInvocationID;
+    const uint S = gl_SubgroupSize;
+
+    const uint a_base = get_aoffset() + src0_idx(row * p.ne00);
+    const uint d_base = get_doffset() + dst_idx(row * p.ne10);
+
+    vec2 sum = vec2(0.0f, 0.0f);
+    for (uint i0 = lane; i0 < p.ne00; i0 += S) {
+        const float xi = float(data_a[a_base + i0*p.nb00]);
+        sum += vec2(xi, xi * xi);
+    }
+    sum = subgroupAdd(sum);
+
+    const float mean = sum.x / p.ne00;
+    const float var = sum.y / p.ne00 - mean * mean;
+    const float inv_std = inversesqrt(var + p.param1);
+
+    for (uint i0 = lane; i0 < p.ne00; i0 += S) {
+        const float xi = float(data_a[a_base + i0*p.nb00]);
+        data_d[d_base + i0*p.nb10] = D_TYPE((xi - mean) * inv_std);
+    }
+}
