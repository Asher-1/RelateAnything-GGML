+        same = same && options->vk_disable_graph_optimize == runtime_options.vk_disable_graph_optimize;
+        same = same && options->vk_disable_coopmat == runtime_options.vk_disable_coopmat;
+        same = same && options->vk_disable_coopmat2 == runtime_options.vk_disable_coopmat2;
+        same = same && options->vk_disable_coopmat2_decode_vector == runtime_options.vk_disable_coopmat2_decode_vector;
