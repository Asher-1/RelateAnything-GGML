+// ggml_compute_forward_grid_sample
+
+static float ggml_grid_sample_source(float coord, int64_t size) {
+    // grid_sampler_compute_source_index, zeros padding, align_corners=False
+    const float x = ((coord + 1.f) * size - 1) / 2;
+    if (x > INT_MAX - 1 || x < INT_MIN || !std::isfinite(x)) {
+        return -100.0f;
+    }
+    return x;
+}
+
+void ggml_compute_forward_grid_sample(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * grid = dst->src[1];
+    GGML_ASSERT(ggml_is_contiguous(src0) && ggml_is_contiguous(grid) && ggml_is_contiguous(dst));
+
+    const int64_t W = src0->ne[0], H = src0->ne[1], C = src0->ne[2];
+    const int64_t out_W = dst->ne[0], out_H = dst->ne[1];
+    const int64_t total = out_W * out_H * dst->ne[3];
+    const float * x = (const float *) src0->data;
+    const float * g = (const float *) grid->data;
+    float * y = (float *) dst->data;
+    const auto inside = [&](int64_t iy, int64_t ix) { return iy >= 0 && iy < H && ix >= 0 && ix < W; };
+
+    for (int64_t index = params->ith; index < total; index += params->nth) {
+        const int64_t n = index / (out_H * out_W);
+        const int64_t hw = index % (out_H * out_W);
+        const float ix = ggml_grid_sample_source(g[2 * index], W);
+        const float iy = ggml_grid_sample_source(g[2 * index + 1], H);
+        const int64_t ix_nw = (int64_t) std::floor(ix), iy_nw = (int64_t) std::floor(iy);
+        const int64_t ix_ne = ix_nw + 1, iy_ne = iy_nw, ix_sw = ix_nw, iy_sw = iy_nw + 1;
+        const int64_t ix_se = ix_nw + 1, iy_se = iy_nw + 1;
+        const float nw = (ix_se - ix) * (iy_se - iy);
+        const float ne = (ix - ix_sw) * (iy_sw - iy);
+        const float sw = (ix_ne - ix) * (iy - iy_ne);
+        const float se = (ix - ix_nw) * (iy - iy_nw);
+        for (int64_t c = 0; c < C; ++c) {
+            const float * plane = x + (n * C + c) * H * W;
+            float acc = 0;
+            if (inside(iy_nw, ix_nw)) acc += plane[iy_nw * W + ix_nw] * nw;
+            if (inside(iy_ne, ix_ne)) acc += plane[iy_ne * W + ix_ne] * ne;
+            if (inside(iy_sw, ix_sw)) acc += plane[iy_sw * W + ix_sw] * sw;
+            if (inside(iy_se, ix_se)) acc += plane[iy_se * W + ix_se] * se;
+            y[(n * C + c) * out_H * out_W + hw] = acc;
+        }
+    }
+}
