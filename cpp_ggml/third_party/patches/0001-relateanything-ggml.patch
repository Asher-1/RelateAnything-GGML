+struct ggml_runtime_options ggml_runtime_default_options(void) {
+    struct ggml_runtime_options options = {};
+    options.struct_size = sizeof(options);
+    options.abi_version = GGML_RUNTIME_OPTIONS_ABI_VERSION;
+    options.sched_debug_realloc = -1;
+    options.cuda_pdl = -1;
+    options.op_offload_min_batch = 32;
+    options.vk_max_nodes_per_submit = 100;
+    options.vk_perf_logger_frequency = 1;
+    options.cuda_ar_copy_threshold = 1048576;
+    options.cuda_ar_copy_chunk_bytes = 0;
+    options.cuda_ar_bf16_threshold = 1;
+    return options;
+}
+namespace {
+ggml_runtime_options runtime_options = ggml_runtime_default_options();
+std::mutex runtime_mutex;
+std::atomic<bool> runtime_frozen{false};
+}
+const struct ggml_runtime_options * ggml_runtime_get_options(void) {
+    if (!runtime_frozen.load(std::memory_order_acquire)) {
+        std::lock_guard<std::mutex> lock(runtime_mutex);
+        runtime_frozen.store(true, std::memory_order_release);
+    }
+    return &runtime_options;
+}
+bool ggml_runtime_configure(const struct ggml_runtime_options * options) {
+    if (!options || options->struct_size != sizeof(*options) ||
+        options->abi_version != GGML_RUNTIME_OPTIONS_ABI_VERSION ||
+        options->op_offload_min_batch < 0 || options->vk_max_nodes_per_submit < 1 ||
+        options->vk_perf_logger_frequency < 1 || options->cuda_devices < 0 ||
+        options->cuda_pdl < -1 || options->cuda_pdl > 1 || options->sched_debug_realloc < -1) return false;
+    if (!std::memchr(options->backend_path, 0, sizeof(options->backend_path))) return false;
+    if (!std::memchr(options->cuda_allreduce, 0, sizeof(options->cuda_allreduce))) return false;
+    if (!std::memchr(options->cuda_cublas_compute_type, 0, sizeof(options->cuda_cublas_compute_type))) return false;
+    if (!std::memchr(options->vk_visible_devices, 0, sizeof(options->vk_visible_devices))) return false;
+    if (!std::memchr(options->vk_pipeline_stats, 0, sizeof(options->vk_pipeline_stats))) return false;
+    std::lock_guard<std::mutex> lock(runtime_mutex);
+    if (runtime_frozen.load(std::memory_order_acquire)) {
