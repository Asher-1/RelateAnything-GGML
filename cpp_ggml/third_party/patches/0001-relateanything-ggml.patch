+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include "ggml.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define GGML_RUNTIME_OPTIONS_ABI_VERSION 1u
+/* Process-runtime configuration: configure before backend discovery or workers.
+ * The first configure freezes values. Identical calls succeed; conflicts fail.
+ * Strings are copied; no environment variable controls these supported paths. */
+struct ggml_runtime_options {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    bool no_backtrace;
+    bool backtrace_lldb;
+    bool cpu_disable_fusion;
+    bool cuda_enable_unified_memory;
+    bool cuda_p2p;
+    bool cuda_no_pinned;
+    bool cuda_disable_fusion;
+    bool cuda_graph_opt;
+    bool cuda_register_host;
+    bool cuda_disable_graphs;
+    bool vk_prefer_host_memory;
+    bool vk_disable_host_visible_vidmem;
+    bool vk_allow_sysmem_fallback;
+    bool vk_disable_graph_optimize;
+    bool vk_disable_coopmat;
+    bool vk_disable_coopmat2;
+    bool vk_disable_coopmat2_decode_vector;
+    bool vk_disable_integer_dot_product;
+    bool vk_disable_bfloat16;
+    bool vk_disable_dot2;
+    bool vk_enable_memory_priority;
+    bool vk_disable_async;
+    bool vk_disable_f16;
+    bool vk_allow_graphics_queue;
+    bool vk_disable_ocp_fp4;
+    bool vk_disable_multi_add;
+    bool vk_async_use_transfer_queue;
+    bool vk_serialize_submissions;
+    bool vk_disable_fusion;
+    bool vk_disable_mmvq;
+    bool vk_force_mmvq;
+    bool vk_debug_markers;
+    bool vk_perf_logger;
+    bool vk_perf_logger_concurrent;
+    bool vk_sync_logger;
+    bool vk_memory_logger;
+    int32_t sched_debug;
+    int32_t sched_debug_realloc;
+    int32_t meta_debug;
+    int32_t cuda_devices;
+    int32_t cuda_pdl;
+    int32_t op_offload_min_batch;
+    int32_t vk_max_nodes_per_submit;
+    int32_t vk_perf_logger_frequency;
+    int32_t vulkan_skip_checks;
+    int32_t vulkan_output_tensor;
+    uint64_t vk_force_max_allocation_size;
+    uint64_t vk_force_max_buffer_size;
+    uint64_t vk_suballocation_block_size;
+    uint64_t cuda_ar_copy_threshold;
+    uint64_t cuda_ar_copy_chunk_bytes;
+    uint64_t cuda_ar_bf16_threshold;
+    char backend_path[1024];
+    char cuda_allreduce[16];
+    char cuda_cublas_compute_type[16];
+    char vk_visible_devices[256];
+    char vk_pipeline_stats[256];
+};
+GGML_API struct ggml_runtime_options ggml_runtime_default_options(void);
+GGML_API bool ggml_runtime_configure(const struct ggml_runtime_options * options);
+GGML_API const struct ggml_runtime_options * ggml_runtime_get_options(void);
+#ifdef __cplusplus
+}
+#endif
