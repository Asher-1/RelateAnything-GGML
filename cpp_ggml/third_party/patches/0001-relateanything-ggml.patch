+
+// The only strict GELU is the epilogue of a strict MUL_MAT + bias ADD.
+static bool ggml_cuda_strict_gelu_domain(const ggml_tensor * op) {
+    const ggml_tensor * add = op->src[0];
+    if (op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op) || add->op != GGML_OP_ADD ||
+        !ggml_are_same_shape(add, op)) {
+        return false;
+    }
+    for (int i = 0; i < 2; ++i) {
+        const ggml_tensor * mm = add->src[i];
+        if (mm->op == GGML_OP_MUL_MAT && ggml_get_op_params_i32(mm, 1) == GGML_HINT_STRICT_F32) {
+            return true;
+        }
+    }
+    return false;
+}
