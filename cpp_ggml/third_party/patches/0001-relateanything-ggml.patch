+static bool ggml_cuda_strict_gelu_domain(const ggml_tensor * op) {
+    const ggml_tensor * add = op->src[0];
+    if (op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op) || add->op != GGML_OP_ADD ||
+        !ggml_are_same_shape(add, op)) {
