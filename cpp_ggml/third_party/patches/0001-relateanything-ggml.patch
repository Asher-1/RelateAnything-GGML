diff --git a/src/ggml-vulkan/vulkan-shaders/add_gelu.comp b/src/ggml-vulkan/vulkan-shaders/add_gelu.comp
new file mode 100644
index 00000000..d6e48fa4
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/add_gelu.comp
@@ -0,0 +1,55 @@
+#version 450
+
+#extension GL_EXT_shader_16bit_storage : require
+
+#include "types.glsl"
+#include "generic_binary_head.glsl"
+
+const uint num_threads = 256;
+
+// Declared to match add.comp's descriptor layout (the op_f32 ADD path binds
+// four buffers); unused by this epilogue shader.
+layout (binding = 3, std430) buffer PartialBuf {float partial_sums[];};
+
+layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;
+
+// Abramowitz and Stegun 7.1.26 (same Hastings approximation as unary.comp's
+// op_gelu_erf), applied as an epilogue so the standalone gelu node can be
+// skipped when the graph pairs this add with a following GELU_ERF.
+float gelu_erf(float a) {
+    const float p_erf  = 0.3275911f;
+    const float a1_erf = 0.254829592f;
+    const float a2_erf = -0.284496736f;
+    const float a3_erf = 1.421413741f;
+    const float a4_erf = -1.453152027f;
+    const float a5_erf = 1.061405429f;
+
+    const float SQRT_2_INV = 0.70710678118654752440084436210484f;
+    const float a_div_sqr2 = a * SQRT_2_INV;
+    const float sign_x = a_div_sqr2 >= 0.0f ? 1.0f : -1.0f;
+    const float x = abs(a_div_sqr2);
+    const float t = 1.0f / (1.0f + p_erf * x);
+    const float y = 1.0f - (((((a5_erf * t + a4_erf) * t) + a3_erf) * t + a2_erf) * t + a1_erf) * t * exp(-x * x);
+    return 0.5f * a * (1.0f + sign_x * y);
+}
+
+void main() {
+    uint idx = get_idx();
+
+    // num_threads * num_iter must equal 512, to match the wg_denoms and get_idx calculation
+    const uint num_iter = 2;
+
+    [[unroll]] for (uint i = 0; i < num_iter; ++i) {
+        if (idx >= p.ne) {
+            continue;
+        }
+        uint i00, i01, i02, i03;
+        get_indices(idx, i00, i01, i02, i03);
+
+        float sum = float(data_a[get_aoffset() + src0_idx(i00, i01, i02, i03)]) + float(data_b[get_boffset() + src1_idx(i00, i01, i02, i03)]);
+
+        data_d[get_doffset() + dst_idx(i00, i01, i02, i03)] = D_TYPE(gelu_erf(sum));
+
+        idx += num_threads;
+    }
+}
