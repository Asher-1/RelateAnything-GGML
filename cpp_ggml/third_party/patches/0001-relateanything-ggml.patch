+// Strict F32 MUL_MAT followed by a 1-D bias ADD, as one PyTorch addmm. The
+// weight is a 2-D matrix and all rows of src1 form the flattened input. With
+// gelu, the GELU consuming the ADD is the epilogue (_addmm_activation) and
+// receives the result.
+static bool ggml_cuda_strict_mul_mat_bias(ggml_backend_cuda_context & ctx, const ggml_tensor * mm, ggml_tensor * add,
+                                          ggml_tensor * gelu = nullptr) {
+    const ggml_tensor * w = mm->src[0];
+    const ggml_tensor * x = mm->src[1];
+    const ggml_tensor * bias = add->src[0] == mm ? add->src[1] : add->src[0];
+    ggml_tensor * out = gelu ? gelu : add;
+    if (add->src[0] == add->src[1] || w->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 ||
+        bias->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 ||
+        w->ne[2] != 1 || w->ne[3] != 1 ||
+        !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(bias) ||
+        !ggml_is_contiguous(add) || !ggml_is_contiguous(out) || !ggml_are_same_shape(add, out) ||
+        bias->ne[0] != w->ne[1] || ggml_nelements(bias) != w->ne[1]) {
+        return false;
+    }
+    ggml_cuda_pool_alloc<uint8_t> workspace(ctx.pool(), GGML_CUDA_STRICT_LT_WORKSPACE);
+    cublasHandle_t handle = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(handle, ctx.stream()));
+    return ggml_cuda_strict_linear_bias(handle, (const float *) w->data, (const float *) x->data,
+        (const float *) bias->data, (float *) out->data, w->ne[0], w->ne[1], ggml_nrows(x),
+        w->nb[1] / sizeof(float), x->nb[1] / sizeof(float), out->nb[1] / sizeof(float),
+        gelu != nullptr, workspace.get(), ctx.stream());
