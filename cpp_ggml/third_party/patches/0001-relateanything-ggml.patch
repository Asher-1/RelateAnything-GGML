+static bool ggml_cuda_strict_gelu_hint(const ggml_tensor * op) {
+    return op->op == GGML_OP_UNARY && ggml_get_unary_op(op) == GGML_UNARY_OP_GELU &&
+        ggml_get_op_params_i32(op, 1) == GGML_HINT_STRICT_F32;
