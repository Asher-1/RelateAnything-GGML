--- a/src/ggml-cuda/unary.cu
+++ b/src/ggml-cuda/unary.cu
@@ -178,6 +178,48 @@ void ggml_cuda_op_gelu_erf(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     ggml_cuda_op_unary<op_gelu_erf>(ctx, dst);
 }
 
+// Consumer of GGML_EPILOGUE_GELU: applies gelu_erf at a bias ADD's write-out
+// so the graph can skip the following standalone GELU_ERF node (the CUDA
+// counterpart of vulkan-shaders/add_gelu.comp). The ADD mirrors k_bin_bcast
+// for a 1-D contiguous bias (dst[i] = a[i] + b[i % ne0]) and the activation
+// reuses op_gelu_erf, so the fused result is bit-identical to the unfused
+// ADD + unary_op_kernel<&op_gelu_erf> pair. Returns false on any domain
+// mismatch; the caller then falls back to the unfused nodes.
+static __global__ void add_gelu_erf_bias_kernel(const float * a, const float * b, float * dst,
+                                                const int64_t ne0, const int64_t n) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = (int64_t)blockDim.x*blockIdx.x + threadIdx.x;
+
+    if (i >= n) {
+        return;
+    }
+
+    ggml_cuda_pdl_sync();
+    dst[i] = op_gelu_erf(a[i] + b[i % ne0]);
+}
+
+bool ggml_cuda_op_add_gelu_erf(ggml_backend_cuda_context & ctx, const ggml_tensor * add, ggml_tensor * gelu) {
+    const ggml_tensor * a = add->src[0];
+    const ggml_tensor * b = add->src[1];
+
+    if (add->type != GGML_TYPE_F32 || gelu->type != GGML_TYPE_F32 ||
+        a == nullptr || b == nullptr || a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 ||
+        gelu->src[0] != add ||
+        ggml_is_empty(a) || !ggml_is_contiguous(a) || !ggml_is_contiguous(add) ||
+        !ggml_is_contiguous(gelu) || !ggml_are_same_shape(a, add) || !ggml_are_same_shape(add, gelu) ||
+        ggml_nrows(b) != 1 || b->ne[0] != a->ne[0] || !ggml_is_contiguous(b)) {
+        return false;
+    }
+
+    const int64_t n = ggml_nelements(gelu);
+    const int num_blocks = (int) ((n + CUDA_GELU_BLOCK_SIZE - 1) / CUDA_GELU_BLOCK_SIZE);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params((dim3) num_blocks,
+        CUDA_GELU_BLOCK_SIZE, 0, ctx.stream());
+    ggml_cuda_kernel_launch(add_gelu_erf_bias_kernel, launch_params,
+        (const float *) a->data, (const float *) b->data, (float *) gelu->data, gelu->ne[0], n);
+    return true;
+}
+
 void ggml_cuda_op_gelu_quick(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     ggml_cuda_op_unary<op_gelu_quick>(ctx, dst);
 }
