# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp

# Weights, caches and data: downloaded or built, never committed
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.engine
*.bin
*.xml
*_deploy.pt
checkpoints/
datasets/
runs/
# Benchmark measurements are local artifacts; commit only their Markdown reports.
docs/benchmarks/*.json
docs/benchmarks/*.json.gz
# Keep source-of-truth third-party dependencies only in their owning module.
third_party/
!cpp_ggml/
!cpp_ggml/third_party/
!cpp_ggml/third_party/ggml/
!cpp_ggml/third_party/patches/
!cpp_ggml/third_party/scripts/

# Local GGML build and generated adapter fixtures.
cpp_ggml/build-*/
cpp_ggml/test_data/*.raio
cpp_ggml/test_data/*.raoo
cpp_ggml/test_data/*.npz
cpp_ggml/models/gguf/*.gguf
cpp_ggml/models/pytorch/relsgg-*/
cpp_ggml/test_data/official/
# The compact 50-image RA-4M suite is intentionally retained for reproducible
# evaluation. Source-corpus licensing is documented in test_data/README.md.
.hf_cache/
wandb/
mobileclip*.ts

# deploy/dist: track only the small source-of-truth files per bundle. Graphs,
# weights and the locally rebuilt detector (AGPL upstream) stay out.
deploy/dist/*
!deploy/dist/README.md
!deploy/dist/requirements.txt
!deploy/dist/relsgg-*/
deploy/dist/relsgg-*/*
!deploy/dist/relsgg-*/relateanything.json
!deploy/dist/relsgg-*/predicate_bank.npz
!deploy/dist/relsgg-*/thresholds.json
!deploy/dist/relsgg-*/calibration.json
!deploy/dist/relsgg-*/README.md

# Rendered by deploy/make_reel.py from the tracked inputs beside them
# (images/, credits.json, shots.json). The README ships assets/hero.gif and the
# project page ships the video, so the copies under assets/reel/ are build
# output, not sources.
assets/reel/reel.mp4
assets/reel/hero.gif
assets/reel/poster.jpg

# The report PDF: read it on arXiv rather than carrying 12 MB per revision here
main.pdf

# Reproducible full-graph diagnostic tensors remain local for packaging.
cpp_ggml/test_data/*.raim
cpp_ggml/benchmarks/**/*.raim
cpp_ggml/benchmarks/**/*.raip
cpp_ggml/benchmarks/**/*.rafo
cpp_ggml/benchmarks/**/*.npz
cpp_ggml/benchmarks/**/*.f32
